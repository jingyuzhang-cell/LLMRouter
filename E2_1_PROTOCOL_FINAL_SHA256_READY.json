  "experimental_chain": "E1.1_FAIL → E2_EXPLORATORY_POSITIVE → E2.1-A_OBJECTIVE_CONFIRMATION → E2.1-B_CAUSAL_VALIDATION → E2.2_ROUTER",

  "finalized_parameters": {
    "e2_1_a_tasks": 105,
