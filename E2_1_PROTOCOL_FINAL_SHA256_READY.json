      "ci_lower_bound_for_effect_0.04": 0.0094
    },
    "justification": "Achieves 71.8% power for effect size 0.04 based on E2 exploratory signal, with adequate precision (CI lower > 0)"
  },

  "e2_1_a_protocol": {
    "primary_validation_layer": "Node-level Specialization Confirmation",

    "tasks": {
      "final_n": 105,
      "power_analysis_completed": "BEFORE protocol finalization, outcome-blind",
      "sources": ["FinLongDocQA", "TAT-QA", "FinanceBench", "long-context-financial-tasks"],
      "selection_criteria": "Outcome-blind based on observable complexity, balanced across sources",
      "diversity_requirement": "Representative distribution of evidence localization complexity"
    },

    "models": {
      "candidates": ["qwen-plus", "glm-5.2", "deepseek"],
      "anchor": "qwen-plus",
      "repeats": 3,
      "repeat_design": "Rotating held-out: (1,2)→3, (1,3)→2, (2,3)→1",
      "total_estimated_calls": "105 × 3 × 3 = 945 N1 evidence calls",
      "estimated_cost": "$4-5"
    },

    "primary_node": {
      "node_id": "n1",
      "node_type": "evidence_localization",
      "output_format": "STRUCTURED_EVIDENCE_IDS_ONLY",
      "required_output_schema": {
        "evidence_ids": ["string IDs: docX_pY_sZ (text), tableA_rB_cC (tabular)"]
      },
      "prohibited_output": "Free-form text, explanations, evidence descriptions, reasoning",
      "scoring_target": "Evidence ID retrieval capability, NOT language generation quality"
    },

    "gold_annotation": {
      "required_fields": {
        "gold_evidence_set": ["canonical evidence IDs"],
        "acceptable_alternative_sets": [
          {
            "evidence_ids": ["equivalent evidence IDs"],
            "equivalence_explanation": "brief justification of equivalence"
          }
        ]
      },
      "quality_control": {
        "method": "Dual-annotation for 10-task subset (9.5%)",
        "iaa_metric": "Mean Evidence F1 between annotators",
        "iaa_threshold": 0.85,
        "below_threshold_action": "Third senior annotator adjudication"
      }
    },

    "scoring_system": {
      "predicted_set": "Model output evidence IDs",
      "gold_sets": "Union of gold_evidence_set and all acceptable_alternative_sets",
      "calculations": {
        "precision": "|Predicted ∩ Gold| / |Predicted|",
        "recall": "|Predicted ∩ Gold| / |Gold|",
        "task_quality": "max over gold sets of 2×P×R/(P+R)"
      },
      "tie_handling": {
        "epsilon": 0.01,
        "definition": "|Q₁ - Q₂| < 0.01 considered tie",
        "margin_calculation": "Margin = Q_(1) - Q_(2), Tie Rate reported"
      }
    },

    "primary_endpoint": {
      "metric": "Stable Semantic Oracle Gap (G_N1)",
      "semantic_quality": "Objective Evidence F1",
      "calculation": "G_N1 = Q^stable-oracle_N1 - Q^best-single_N1",
      "primary_pass_gate": "G_N1 ≥ 0.04 AND bootstrap 95% CI_lower(G_N1) > 0",
      "statistical_requirement": "Both effect size and statistical significance must be met"
    },

    "secondary_endpoints": {
      "stable_specialist_opportunity_rate": {
        "metric": "S_N1",
        "supporting_threshold": "S_N1 ≥ 10%",
        "role": "Confirms specialist opportunity exists (supporting evidence)"
      },
      "margin_analysis": {
        "metrics": ["Mean Margin", "Median Margin", "Tie Rate"],
        "supporting_requirement": "Median Margin > 0",
        "role": "Shows signal strength and separation (supporting evidence)"
      },
      "held_out_reversal_rate": {
        "metric": "R_N1 (Held-out Top1–Top2 Reversal Rate)",
        "role": "Stability diagnostic - REPORT ONLY, no success/fail gate"
      }
    },

    "success_criteria": {
      "primary_requirement": "G_N1 ≥ 0.04 AND 95% CI_lower(G_N1) > 0",
      "secondary_support": "S_N1 ≥ 10% AND Median Margin > 0",
      "overall_pass": "Primary requirement AND secondary support",
      "fail_action": "STOP N1 hypothesis, exploratory signal was heuristic-driven"
    },

    "statistical_analysis": {
      "method": "Task-level paired bootstrap (10,000 samples)",
      "ci_level": 95,
      "repeat_handling": "Average across three rotation schemes",
      "multiple_comparison": "Bonferroni correction for secondary endpoints"
    }
  },

