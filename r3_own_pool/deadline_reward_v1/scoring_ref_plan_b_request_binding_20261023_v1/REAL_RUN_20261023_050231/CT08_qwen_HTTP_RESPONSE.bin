{"model":"qwen-plus","id":"chatcmpl-869bca52-628a-9060-8482-bdfc703ffbaf","choices":[{"message":{"content":"{\n  \"task_id\": \"CT08\",\n  \"key_facts\": [\n    {\n      \"subject\": \"江苏舜天股份有限公司\",\n      \"predicate\": \"违法行为性质\",\n      \"value\": \"参与隋某力主导的专网通信虚假自循环业务，无商业实质，虚增营业收入、营业成本及利润\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"江苏舜天参与的隋某力主导的专网通信业务,实质是合同、资金、票据流转构成闭环的虚假自循环业务,无商业实质,不应确认相应的营业收入、营业成本及利润。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"江苏舜天股份有限公司\",\n      \"predicate\": \"虚假记载时间范围\",\n      \"value\": \"2009年至2021年年度报告\",\n      \"date\": \"2009-2021\",\n      \"date_type\": \"event\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"江苏舜天通过参与通讯器材内贸虚假自循环业务,2009年至2021年年度报告共计虚增营业收入10,333,448,392.98元,虚增营业成本9,398,996,635.72元,虚增利润总额934,451,757.26元。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"江苏舜天股份有限公司\",\n      \"predicate\": \"会计差错更正公告日期\",\n      \"value\": \"2022年4月30日\",\n      \"date\": \"2022-04-30\",\n      \"date_type\": \"publication\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"2022年4月30日,江苏舜天发布《江苏舜天股份有限公司关于会计差错更正的公告》,将通讯器材业务的收入确认方法由总额法调整为净额法,对2009年至2020年年度报告进行了追溯调整,该公告中调整后的财务数据仍存在虚假记载。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"江苏舜天股份有限公司\",\n      \"predicate\": \"行政处罚决定书文号\",\n      \"value\": \"〔2024〕41号\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"中国证监会行政处罚决定书（江苏舜天及其责任人员）\\n〔\\n2024\\n〕\\n41\\n号\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"江苏舜天股份有限公司\",\n      \"predicate\": \"罚款金额\",\n      \"value\": 10000000,\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": 10000000,\n      \"unit\": \"元\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"一、对江苏舜天股份有限公司责令改正,给予警告,并处以1,000万元罚款;\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"高松\",\n      \"predicate\": \"职务期间（与通讯器材业务相关）\",\n      \"value\": \"2014年9月至2015年5月、2016年12月至2018年9月分管、审批通讯器材内贸业务；2018年至2021年与隋某力洽谈合作通讯器材业务\",\n      \"date\": \"2014-09/2021\",\n      \"date_type\": \"event\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"高松分别在2014年9月至2015年5月、2016年12月至2018年9月分管、审批通讯器材内贸业务,在2018年至2021年与隋某力洽谈合作通讯器材业务。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"高松\",\n      \"predicate\": \"行政处罚金额\",\n      \"value\": 1500000,\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": 1500000,\n      \"unit\": \"元\",\n      \"source_doc_id\": \"csrc_penalty_2024_41\",\n      \"page\": null,\n      \"section_id\": \"saved_html_text\",\n      \"quote\": \"二、对高松给予警告,并处以150万元罚款;\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },