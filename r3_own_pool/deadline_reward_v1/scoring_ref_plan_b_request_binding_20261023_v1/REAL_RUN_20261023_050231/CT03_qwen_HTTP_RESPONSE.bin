{"model":"qwen-plus","id":"chatcmpl-b8e45f45-ee40-94b2-a077-807976615f78","choices":[{"message":{"content":"{\n  \"task_id\": \"CT03\",\n  \"key_facts\": [\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"收到中国证监会立案告知书\",\n      \"value\": \"因公司2023年年报涉嫌信息披露违法违规，中国证监会决定对公司立案\",\n      \"date\": \"2026-10-09\",\n      \"date_type\": \"receipt\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"E05-nachuan\",\n      \"page\": 1,\n      \"section_id\": null,\n      \"quote\": \"2026 年 10 月 9 日，福建纳川管材科技股份有限公司（以下简称“公司”）收到中国证券监督管理委员会（以下简称“中国证监会”）下发的《中国证券监督管理委员会立案告知书》（编号：证监立案字 0262026012 号）。因公司 2023 年年报涉嫌信息披露违法违规，根据《中华人民共和国证券法》《中华人民共和国行政处罚法》等法律法规，中国证监会决定对公司立案。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"股票被实施退市风险警示\",\n      \"value\": \"因利润总额、净利润、扣除非经常性损益后的净利润三者均为负值且扣除后营业收入低于1亿元；2025年度期末净资产为-147,791,659.62元；2024年度、2025年度内控审计报告为否定意见\",\n      \"date\": \"2026-04-29\",\n      \"date_type\": \"event\",\n      \"amount\": -147791659.62,\n      \"unit\": \"CNY\",\n      \"source_doc_id\": \"E05-nachuan_sup1\",\n      \"page\": 1,\n      \"section_id\": null,\n      \"quote\": \"福建纳川管材科技股份有限公司（以下简称“公司”或“纳川股份”）于 2026 年 4 月 28 日披露了《关于公司股票交易将被实施退市风险警示并继续叠加其他风险警示暨股票停复牌的提示性公告》（公告编号：2026-089），公司利润总额、净利润、扣除非经常性损益后的净利润三者均为负值，且扣除后的营业收入低于 1 亿元；公司 2025 年度期末净资产为-147,791,659.62 元；公司 2024 年度、2025 年度内控审计报告为否定意见。根据《深圳证券交易所创业板股票上市规则》（2026 年修订）……公司股票于 2026 年 4 月 29 日开市起被实施退市风险警示。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"股票可能被终止上市\",\n      \"value\": \"若公司2026年年度报告出现《上市规则》第10.3.11条所列任一情形，公司股票将被终止上市\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"E05-nachuan_sup1\",\n      \"page\": 3,\n      \"section_id\": null,\n      \"quote\": \"若公司 2026 年年度报告出现上述情形之一的，公司股票将被终止上市。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"处于预重整阶段\",\n      \"value\": \"截至本公告披露日，公司处于预重整阶段\",\n      \"date\": \"2026-10-09\",\n      \"date_type\": \"publication\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"E05-nachuan_sup1\",\n      \"page\": 2,\n      \"section_id\": null,\n      \"quote\": \"截至本公告披露日，公司处于预重整阶段。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"2025年度审计报告意见类型\",\n      \"value\": \"保留意见\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"E05-nachuan_sup1\",\n      \"page\": 1,\n      \"section_id\": null,\n      \"quote\": \"最近三个会计年度扣除非经常性损益前后净利润孰低者均为负值，信永中和会计师事务所（特殊普通合伙）出具的《2025 年度审计报告》审计意见为保留意见，认为存在可能导致对公司持续经营能力产生重大疑虑的重大不确定性。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"2024年度、2025年度内控审计报告意见类型\",\n      \"value\": \"否定意见\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": null,\n      \"unit\": \"UNKNOWN\",\n      \"source_doc_id\": \"E05-nachuan_sup1\",\n      \"page\": 1,\n      \"section_id\": null,\n      \"quote\": \"公司 2024 年度、2025 年度内控审计报告为否定意见。\",\n      \"status\": \"SUPPORTED\",\n      \"confidence_evidence_grade\": \"SOURCE_LITERAL\"\n    },\n    {\n      \"subject\": \"福建纳川管材科技股份有限公司\",\n      \"predicate\": \"2023年度归属于母公司股东的净利润\",\n      \"value\": \"-512,932,838.85 元\",\n      \"date\": null,\n      \"date_type\": \"UNKNOWN\",\n      \"amount\": -512932838.85,\n      \"unit\": \"CNY\",\n      \"source_doc_id\": \"E05-na