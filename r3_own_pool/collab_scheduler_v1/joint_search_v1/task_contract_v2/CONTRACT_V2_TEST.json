  "t3_percent_no_conflict": true,
  "t3_no_false_conflict": true,
  "t4_unparseable_falls_back": true,
  "t5_pool_nonempty": true,
  "t5_changes_counted": true,
  "t5_conflicts_counted": true,
  "t6_close_percent": true,
  "t6_close_derived": true
 },
