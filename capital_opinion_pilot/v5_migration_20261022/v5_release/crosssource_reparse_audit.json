{
 "schema": {
  "name": "crosssource_check_v2",
  "description": "跨来源事实核查：比较两个来源的事实，判断一致性/矛盾/互补/证据不足",
  "output_schema": {
   "type": "object",
   "required": [
    "verdicts"
   ],
   "properties": {
    "verdicts": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "fact",
       "verdict",
       "source_a",
       "source_b"
      ],
      "properties": {
       "fact": {
        "type": "string",
        "description": "被比较的事实描述"
       },
       "verdict": {
        "type": "string",
        "enum": [
         "CONSISTENT",
         "CONTRADICTORY",
         "COMPLEMENTARY",
         "INSUFFICIENT"
        ]
       },
       "source_a": {
        "type": "string",
        "description": "来源A的表述或数值"
       },
       "source_b": {
        "type": "string",
        "description": "来源B的表述或数值"
       },
       "quote_a": {
        "type": "string",
        "description": "来源A的逐字引文≤30字"
       },
       "quote_b": {
        "type": "string",
        "description": "来源B的逐字引文≤30字"
       }
      }
     }
    }
   }
  },
  "system_prompt": "你是调查DAG中的跨来源事实核查节点。比较两个来源关于同一事实的表述。\n只输出一个JSON对象，必须使用\"verdicts\"作为唯一的顶层键名。\n格式：{\"verdicts\":[{\"fact\":\"事实描述\",\"verdict\":\"CONSISTENT|CONTRADICTORY|COMPLEMENTARY|INSUFFICIENT\",\"source_a\":\"来源A表述\",\"source_b\":\"来源B表述\",\"quote_a\":\"≤30字引文\",\"quote_b\":\"≤30字引文\"}]}\n注意：verdicts 是顶层数组键名，不是嵌套在其他对象内。不输出其他文字。"
 },
 "adapter_keys": [
  "verdicts",
  "comparison_result",
  "analysis",
  "consistency",
  "comparisons",
  "detail"
 ],
