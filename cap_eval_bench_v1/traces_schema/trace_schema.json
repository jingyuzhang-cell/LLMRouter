{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cap_eval_bench_v1 run trace",
  "type": "object",
  "required": ["run_id", "system_id", "task_id", "status", "nodes", "wall_s", "deliverable_ref"],
  "properties": {
    "run_id": {"type": "string"},
    "system_id": {"type": "string", "enum": ["planner_static", "structure_opt", "dynamic_joint",
                                              "single_model", "fixed_homogeneous", "other_declared"]},
    "task_id": {"type": "string", "pattern": "^T-[PDMR][0-9]$"},
    "config_hash": {"type": "string"},
    "ts": {"type": "string"},
    "status": {"enum": ["COMPLETE", "INCOMPLETE", "ABORTED"]},
    "planning": {"type": ["object", "null"],
      "properties": {"calls": {"type": "integer"}, "latency_s": {"type": "number"},
                     "usage": {"type": "object", "properties": {"in": {"type": "integer"}, "out": {"type": "integer"}}}}},
    "retrieval": {"type": "object",
      "properties": {"calls": {"type": "integer"}, "chars_injected": {"type": "integer"},
                     "log_ref": {"type": "string"}}},
    "nodes": {"type": "array", "items": {"type": "object",
      "required": ["node_id", "model", "attempt", "usage", "latency_s", "parse_status"],
      "properties": {"node_id": {"type": "string"}, "kind": {"type": "string"},
        "model": {"type": "string"}, "attempt": {"type": "integer", "minimum": 1},
        "repair_of": {"type": "string"}, "call_id": {"type": ["string", "integer"]},
        "usage": {"type": "object", "properties": {"in": {"type": "integer"}, "out": {"type": "integer"}}},
        "latency_s": {"type": "number"}, "parse_status": {"type": "string"},
        "reused": {"type": "boolean"}}}},
    "reuse_events": {"type": "integer"},
    "program_ms": {"type": "number"},
    "wall_s": {"type": "number"},
    "deliverable_ref": {"type": "string"},
    "notes": {"type": "string"}
  }
}
