{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JointDecisionRecord v1 (window1 -> runtime): Z, R, pi",
  "type": "object",
  "required": ["decision_id", "dag_id", "from_structure_version", "to_structure_version", "Z", "R", "pi", "source"],
  "properties": {
    "decision_id": {"type": "string"},
    "dag_id": {"type": "string"},
    "from_structure_version": {"type": "integer"},
    "to_structure_version": {"type": "integer"},
    "source": {"enum": ["REAL", "REPLAY", "SYNTHETIC"]},
    "Z": {"type": "object",
      "required": ["ops"],
      "properties": {"ops": {"type": "array", "items": {"type": "object",
        "required": ["op", "node_id"],
        "properties": {"op": {"enum": ["identity", "add_node", "remove_node", "rewire", "split_node"]},
                       "node_id": {}, "payload": {}}}},
        "semantic_guard": {"type": "object",
          "properties": {"validator": {"type": "string"}, "result": {"enum": ["PASS", "FAIL"]}}}}},
    "R": {"type": "object",
      "required": ["reroutes", "invalidated_closure"],
      "properties": {"reroutes": {"type": "array", "items": {"type": "object",
          "required": ["node_id", "model", "max_attempts"],
          "properties": {"node_id": {"type": "string"}, "model": {"type": "string"},
                         "max_attempts": {"type": "integer"}}}},
        "invalidated_closure": {"type": "array", "items": {"type": "string"}},
        "protected_done_outputs": {"type": "array", "items": {"type": "string"}}}},
    "pi": {"type": "object",
      "required": ["assignment"],
      "properties": {"assignment": {"type": "object",
        "additionalProperties": {"type": "string"}}}},
    "rationale": {"type": "string"}
  }
}
