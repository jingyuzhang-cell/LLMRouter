var affiches=[{"Title":"永辉超市：关于收到上海证券交易所问询函暨公司股票停牌的公告","Time":"2018-01-24 00:00:00","Zw":"    永辉超市股份有限公司于2018年1月23日收到上海证券交易所下发的《关于对永辉超市股份有限公司签订股权投资意向书的问询函》，无法按时回复。经公司申请，公司股票将于2018年1月24日起连续停牌。 <br>    仅供参考，请查阅当日公告全文。<br><br>","website":"cninfo","webpath":"/home/apache/htdocs/finalpage/2018-01-24/cninfo1204358117.js","webTxtID":"1204358117"}];
