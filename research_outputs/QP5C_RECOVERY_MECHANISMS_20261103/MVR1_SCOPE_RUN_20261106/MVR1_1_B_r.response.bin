{"choices":[{"finish_reason":"stop","index":0,"message":{"content":"{\"relations\":[{\"relation\":\"公司与个人罚款合计\",\"value\":\"公司1,000万元；高松150万元；桂生春100万元；王重人、李焱、赵凡各60万元；合计1,430万元\",\"docs\":[\"D2\"],\"quote\":\"对江苏舜天股份有限公司责令改正,给予警告,并处以1,000万元罚款；对高松给予警告,并处以150万元罚款；对桂生春给予警告,并处以100万元罚款；对王重人、李焱、赵凡给予警告,并分别处以60万元罚款\"},{\"relation\":\"2009-2021年年度报告虚增数据\",\"value\":\"虚增营业收入10,333,448,392.98元；虚增营业成本9,398,996,635.72元；虚增利润总额934,451,757.26元\",\"docs\":[\"D2\"],\"quote\":\"2009年至2021年年度报告共计虚增营业收入10,333,448,392.98元，虚增营业成本9,398,996,635.72元，虚增利润总额934,451,757.26元\"},{\"relation\":\"行政处罚决定书文号\",\"value\":\"〔2024〕41号，2024年4月24日\",\"docs\":[\"D2\",\"D3\"],\"quote\":\"文号 〔2024〕41号；《行政处罚决定书》（〔2024〕41 号）及《市场禁入决定书》（〔2024〕10 号）\"},{\"relation\":\"事先告知书文号\",\"value\":\"处罚字〔2023〕37号\",\"docs\":[\"D1\"],\"quote\":\"《行政处罚及市场禁入事先告知书》（处罚字〔2023〕37号）\"},{\"relation\":\"立案日期\",\"value\":\"2022年11月4日收到《立案告知书》（证监立案字0382022008号）\",\"docs\":[\"D1\"],\"quote\":\"于2022年11月4日收到中国证券监督管理委员会下发的《立案告知书》（编号：证监立案字0382022008号）\"},{\"relation\":\"事先告知书收到日期\",\"value\":\"2023年6月30日\",\"docs\":[\"D1\"],\"quote\":\"2023年6月30日，公司收到中国证券监督管理委员会出具的《行政处罚及市场禁入事先告知书》\"},{\"relation\":\"听证日期\",\"value\":\"2023年10月17日\",\"docs\":[\"D2\"],\"quote\":\"我会于2023年10月17日举行了听证会\"},{\"relation\":\"撤回申辩日期\",\"value\":\"2024年3月22日\",\"docs\":[\"D2\"],\"quote\":\"2024年3月22日,上述当事人申请撤回听证和陈述申辩\"},{\"relation\":\"对高松市场禁入\",\"value\":\"是，3年证券市场禁入（市场禁入决定书〔2024〕10号）\",\"docs\":[\"D2\",\"D3\"],\"quote\":\"我会拟决定：对高松采取3年证券市场禁入措施\"}]}","role":"assistant"}}],"created":1793947851,"id":"2026110614503991188acb21cf4abf","model":"glm-5.3-flash","object":"chat.completion","request_id":"2026110614503991188acb21cf4abf","usage":{"completion_tokens":635,"completion_tokens_details":{"reasoning_tokens":0},"prompt_tokens":1344,"prompt_tokens_details":{"cached_tokens":0},"total_tokens":1979}}