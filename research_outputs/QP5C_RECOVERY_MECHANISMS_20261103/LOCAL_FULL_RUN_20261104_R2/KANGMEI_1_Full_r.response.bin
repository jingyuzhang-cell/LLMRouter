\",\"docs\":[\"2019-08-17\"],\"quote\":\"对马兴田、许冬瑾、邱锡伟采取终身证券市场禁入措施\"},{\"relation\":\"跨文档一致性\",\"value\":\"2018-12-29立案调查与2019-08-17处罚告知、2020-05-15处罚决定书指向同一主体康美药业及同一违法事实，事件链条对应一致\",\"docs\":[\"2018-12-29\",\"2019-08-17\",\"2020-05-15\"],\"quote\":\"公司收到证监会《行政处罚决定书》（[2020]24 号）及《市场禁入决定书》（[2020]6 号）\"}]}","role":"assistant"}}],"created":1793724906,"id":"20261104005459f511853a996d4a95","model":"glm-5.3-flash","object":"chat.completion","request_id":"20261104005459f511853a996d4a95","usage":{"completion_tokens":916,"completion_tokens_details":{"reasoning_tokens":0},"prompt_tokens":1379,"prompt_tokens_details":{"cached_tokens":0},"total_tokens":2295}}