{"choices":[{"finish_reason":"stop","index":0,"message":{"content":"{\"facts\":[{\"field\":\"立案链-立案调查通知书编号\",\"value\":\"粤证调查通字180199号\",\"doc\":\"2018-12-29\",\"page\":1,\"quote\":\"《调查通知书》（编号：粤证调查通字 180199号）\"},{\"field\":\"立案链-立案日期\",\"value\":\"2018年12月28日收到，因涉嫌信息披露违法违规被立案调查\",\"doc\":\"2018-12-29\",\"page\":1,\"quote\":\"2018 年 12 月 28 日……收到中国证券监督管理委员会……因你公司涉嫌信息披露违法违规……我会决定对你公司立案调查\"},{\"field\":\"虚增金额-2016年报虚增营业收入\",\"value\":\"89.99亿元\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"《2016 年年度报告》虚增营业收入 89.99 亿元\"},{\"field\":\"虚增金额-2017年报虚增营业收入\",\"value\":\"100.32亿元\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"《2017 年年度报告》 虚增营业收入 100.32 亿元\"},{\"field\":\"虚增金额-2016年报虚增货币资金\",\"value\":\"22,548,513,485.42元（占总资产41.13%、净资产76.74%）\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"《2016 年年度报告》虚增货币资金 22,548,513,485.42 元，占公司披露总资产的 41.13%和净资产的 76.74%\"},{\"field\":\"虚增金额-2017年报虚增货币资金\",\"value\":\"29,944,309,821.45元（占总资产43.57%、净资产93.18%）\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"《2017 年年度报告》虚增货币资金 29,944,309,821.45 元，占公司披露总资产的 43.57%和净资产的 93.18%\"},{\"field\":\"虚增金额-2018半年报虚增货币资金\",\"value\":\"36,188,038,359.50元（占总资产45.96%、净资产108.24%）\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"《2018 年半年度报告》虚增货币资金 36,188,038,359.50 元，占公司披露总资产的 45.96%和净资产的 108.24%\"},{\"field\":\"虚增金额-2018年报虚增固定资产\",\"value\":\"11.89亿元\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"虚增固定资产 11.89 亿元\"},{\"field\":\"虚增金额-2018年报虚增在建工程\",\"value\":\"4.01亿元\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"虚增在建工程 4.01 亿元\"},{\"field\":\"虚增金额-2018年报虚增投资性房地产\",\"value\":\"20.15亿元\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"虚增投资性房地产 20.15 亿元\"},{\"field\":\"手法-虚增货币资金\",\"value\":\"财务不记账、虚假记账，伪造、变造大额定期存单或银行对账单，配合营业收入造假伪造销售回款\",\"doc\":\"2019-08-17\",\"page\":2,\"quote\":\"通过财务不记账、虚假记账，伪造、变造大额定期存单或银行对账单，配合营业收入造假伪造销售回款等方式，虚增货币资金\"},{\"field\":\"处罚金额-公司\",\"value\":\"责令改正，警告，罚款60万元\",\"doc\":\"2019-08-17\",\"page\":3,\"quote\":\"对康美药业股份有限公司责令改正，给予警告，并处以 60 万元的罚款\"},{\"field\":\"处罚金额-马兴田、许冬瑾\",\"value\":\"警告，各罚款90万元（主管人员30万元+实际控制人60万元）\",\"doc\":\"2019-08-17\",\"page\":4,\"quote\":\"对马兴田、许冬瑾给予警告，并分别处以 90 万元的罚款，其中作为直接负责的主管人员罚款 30 万元，作为实际控制人罚款 60 万元\"},{\"field\":\"处罚金额-邱锡伟\",\"value\":\"警告，罚款30万元\",\"doc\":\"2019-08-17\",\"page\":4,\"quote\":\"对邱锡伟给予警告，并处以 30 万元的罚款\"},{\"field\":\"处罚金额-庄义清（温少生、马焕洲）\",\"value\":\"警告，各罚款25万元\",\"doc\":\"2019-08-17\",\"page\":4,\"quote\":\"对庄义清、温少生、马焕洲给予警告，并分别处以 25 万元的罚款\"},{\"field\":\"市场禁入-马兴田、许冬瑾、邱锡伟\",\"value\":\"终身证券市场禁入\",\"doc\":\"2019-08-17\",\"page\":4,\"quote\":\"对马兴田、许冬瑾、邱锡伟采取终身证券市场禁入措施\"}]}","role":"assistant"}}],"created":1793724926,"id":"20261104005516eb0cf2c0469e4da9","model":"glm-5.3-flash","object":"chat.completion","request_id":"20261104005516eb0cf2c0469e4da9","usage":{"completion_tokens":1088,"completion_tokens_details":{"reasoning_tokens":0},"prompt_tokens":3542,"prompt_tokens_details":{"cached_tokens":0},"total_tokens":4630}}