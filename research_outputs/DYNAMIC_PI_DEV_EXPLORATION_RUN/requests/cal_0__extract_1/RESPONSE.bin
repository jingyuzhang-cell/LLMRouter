{"choices":[{"finish_reason":"stop","index":0,"message":{"content":"{\"node_id\": \"extract_1\", \"contract\": \"capital.extract.v1\", \"schema\": {\"claims\": [{\"id\": \"extract_1:c1\", \"statement\": \"中控技术于2023年6月9日完成对Hobré International BV的100%股权收购，取得控制权，该交易属于非同一控制下企业合并，购买日为2023年6月9日，依据为办妥交接手续并取得控制权\", \"citations\": [\"SUPCON_ANNUAL:265:0\"]}, {\"id\": \"extract_1:c2\", \"statement\": \"截至2024年4月9日，中控技术拟向荷兰Hobré增资21,795万人民币（折合美元约为3,000万美元），该增资事项已于2023年9月3日经公司第五届董事会第二十三次会议审议通过，但尚需在境内办理外汇审批以及在境外办理注册登记等相关手续，能否完成存在不确定性\", \"citations\": [\"SUPCON_CAPITAL:2:0\", \"SUPCON_CAPITAL:1:0\", \"SUPCON_CAPITAL:6:0\"]}, {\"id\": \"extract_1:c3\", \"statement\": \"Hobré收购与后续拟增资是两个独立事项：前者为2023年6月9日已完成的非同一控制下企业合并；后者为2023年9月董事会批准的、尚未完成审批的资本公积增资行为\", \"citations\": [\"SUPCON_ANNUAL:265:0\", \"SUPCON_CAPITAL:1:0\", \"SUPCON_CAPITAL:2:0\"]}, {\"id\": \"extract_1:c4\", \"statement\": \"交易对价方面：Hobré收购的股权取得成本为94,604,875.37元人民币；拟增资金额为21,795万元人民币，资金来源均为公司GDR募集资金\", \"citations\": [\"SUPCON_ANNUAL:265:0\", \"SUPCON_CAPITAL:1:0\"]}, {\"id\": \"extract_1:c5\", \"statement\": \"资本处理方面：对荷兰Hobré的拟增资款项全部计入资本公积，其注册资本保持不变\", \"citations\": [\"SUPCON_CAPITAL:1:0\", \"SUPCON_CAPITAL:2:0\"]}, {\"id\": \"extract_1:c6\", \"statement\": \"审批状态方面：Hobré收购已完成（购买日2023年6月9日）；拟增资事项已通过董事会审议，但境内外汇审批及境外注册登记手续尚未完成，存在不确定性\", \"citations\": [\"SUPCON_ANNUAL:265:0\", \"SUPCON_CAPITAL:2:0\", \"SUPCON_CAPITAL:6:0\"]}, {\"id\": \"extract_1:c7\", \"statement\": \"文件时点方面：Hobré收购事实载于2023年年度报告第265页（披露时点为2024年发布）；拟增资事项载于2023年9月5日公告（SUPCON_CAPITAL），董事会审议时点为2023年9月3日\", \"citations\": [\"SUPCON_ANNUAL:265:0\", \"SUPCON_CAPITAL:1:0\", \"SUPCON_CAPITAL:6:0\"]}, {\"id\": \"extract_1:c8\", \"statement\": \"已披露事实包括：Hobré收购完成时间、成本、控制权取得方式及购买日；拟增资金额、资金来源、资本处理方式、董事会审批结果及后续审批不确定性；未能确认的执行结果包括：外汇审批及境外注册登记是否已完成、增资款项是否已实际划付、资本公积是否已实际入账\", \"citations\": [\"SUPCON_ANNUAL:265:0\", \"SUPCON_CAPITAL:1:0\", \"SUPCON_CAPITAL:2:0\", \"SUPCON_CAPITAL:6:0\"]}]}}","role":"assistant"}}],"created":1793364156,"id":"chatcmpl-80245236-7f95-984d-bcc4-4932ab6329a9","model":"qwen-plus-2025-12-01","object":"chat.completion","usage":{"completion_tokens":877,"prompt_tokens":3766,"total_tokens":4643}}